import requests
import pandas as pd
import geopandas as gpd
from shapely.geometry import Point

# 1. Requisição direta à API identificada no DevTools
url_api = "https://registropublicodeemissoes.fgv.br/ENDPOINT_ENCONTRADO_NO_DEVTOOLS"

headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
}

response = requests.get(url_api, headers=headers)
data = response.json()

# 2. Transformar o JSON em DataFrame (Ajuste as chaves 'lat'/'lng' conforme o JSON real)
# Exemplo se 'data' for uma lista de dicts:
df = pd.DataFrame(data) 

# Criar GeoDataFrame dos pontos
geometry = [Point(xy) for xy in zip(df['longitude'], df['latitude'])]
gdf_pontos = gpd.GeoDataFrame(df, geometry=geometry, crs="EPSG:4326")

# 3. Carregar o limite geográfico da RMC (GeoJSON ou Shapefile)
gdf_rmc = gpd.read_file("limite_rmc.geojson").to_crs(epsg=4326)

# 4. Point-in-Polygon via Spatial Join
empresas_rmc = gpd.sjoin(gdf_pontos, gdf_rmc, predicate="within")

# Salvar o resultado
empresas_rmc.to_csv("empresas_inventario_rmc.csv", index=False)
print(f"Total de empresas/unidades encontradas na RMC: {len(empresas_rmc)}")
